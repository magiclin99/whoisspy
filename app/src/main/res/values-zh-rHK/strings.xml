<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">誰是間諜</string>
    <string name="tagline">幫您找出偷看手機、偷轉錢的 App，一鍵關掉。</string>
    <string name="scanning">正在幫您檢查手機…</string>
    <string name="summary_danger">有 %d 個 App 可能在偷看您的手機</string>
    <string name="summary_danger_body">它不是從 Play 商店裝的，卻能看到您的簡訊、訊息或螢幕，甚至替您操作手機。如果不是您自己裝的，請馬上刪掉。</string>
    <string name="summary_warning">有 %d 個 App 請您看一下</string>
    <string name="summary_warning_body">它們能看到重要資料或操作手機。如果是您自己開的就沒關係，不認得就關掉。</string>
    <string name="summary_safe">您的手機很安全</string>
    <string name="summary_safe_body">沒有 App 在偷看您的簡訊、訊息或螢幕。裝了新 App 之後，記得再打開檢查一次。</string>
    <string name="section_danger">危險</string>
    <string name="section_warning">請您看一下</string>
    <string name="section_trusted">您認得的 App（%d）</string>
    <string name="tag_sideloaded">不明來源</string>
    <string name="tag_recent">最近才裝的</string>
    <string name="tag_system">內建 App</string>
    <string name="risk_a11y">無障礙服務</string>
    <string name="risk_a11y_desc">能看到您螢幕上的一切，還能替您按按鈕、打字。詐騙集團就是用這個遠端把錢轉走。</string>
    <string name="risk_sms">讀取簡訊</string>
    <string name="risk_sms_desc">能看到您所有的簡訊，包括銀行傳來的驗證碼。</string>
    <string name="risk_notif">通知存取</string>
    <string name="risk_notif_desc">能看到所有通知，包括 LINE 訊息和驗證碼。</string>
    <string name="risk_admin">裝置管理員</string>
    <string name="risk_admin_desc">能鎖住您的手機，還讓您刪不掉它。</string>
    <string name="risk_overlay">顯示在其他應用程式上層</string>
    <string name="risk_overlay_desc">能在銀行 App 上蓋一個假畫面，騙您輸入密碼。</string>
    <string name="risk_install">安裝其他應用程式</string>
    <string name="risk_install_desc">能偷偷再裝更多壞 App。</string>
    <string name="admin_first">要先關掉「裝置管理員」，才能刪掉它。</string>
    <string name="action_revoke">去關掉</string>
    <string name="action_uninstall">刪掉這個 App</string>
    <string name="action_trust">這是我自己裝的</string>
    <string name="action_untrust">重新檢查</string>
    <string name="tips_title">看到這些，就是詐騙</string>
    <string name="tip_1">銀行、政府、客服都不會叫您開「無障礙」，也不會叫您裝 App。</string>
    <string name="tip_2">有人傳連結叫您裝 App，不管說是領補助、看影片、投資賺錢，都不要裝。</string>
    <string name="tip_3">驗證碼誰問都不能說，真的銀行行員也不會問。</string>
    <string name="tip_4">覺得錢可能被轉走，馬上打給銀行，再打 18222 防騙易熱線或報警。</string>
    <string name="section_sideloaded">其他不明來源的 App（%d）</string>
    <string name="section_store_perms">從商店裝的正常 App（%d）</string>
    <string name="section_store_perms_desc">這些是從 Play 商店或手機原廠裝的，像 LINE、鍵盤，需要這些權限很正常。點開可以看。</string>
    <string name="section_sideloaded_desc">目前不會偷看，但如果您不認得，建議刪掉。</string>
    <string name="tag_hidden">隱藏型 App</string>
    <string name="risk_keyboard">外部輸入法（鍵盤）</string>
    <string name="risk_keyboard_desc">您打的每個字，包括密碼和驗證碼，它都看得到。</string>
    <string name="risk_calls">電話與通話紀錄</string>
    <string name="risk_calls_desc">能看到您打給誰，還能把您打給銀行的電話轉到假客服。</string>
    <string name="risk_vpn">VPN</string>
    <string name="risk_vpn_desc">不明來源的 VPN 能偷看您上網的內容。</string>
    <string name="risk_usage">使用情況存取</string>
    <string name="risk_usage_desc">知道您什麼時候打開銀行 App，趁機跳出假畫面。</string>
    <string name="device_vpn">現在有 VPN 連線。如果不是您或家人設定的，請關掉。</string>
    <string name="device_adb">「USB 偵錯」開著，接上電腦就能控制您的手機。不是您或家人開的，請關掉。</string>
    <string name="action_check">去看看</string>
    <string name="privacy_policy">隱私權政策</string>
</resources>
